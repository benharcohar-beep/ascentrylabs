{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix food-truck-app",
  "buildCommand": "cd food-truck-app && npm run build",
  "outputDirectory": "food-truck-app/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
