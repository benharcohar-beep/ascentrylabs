# Copy this file to .env and fill in the three free keys.
# .env is gitignored. Never commit a real key.

# Census ACS. Instant signup, arrives by email, click the activation link.
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# BLS public API v2 (LAUS unemployment). Free registration, key by email.
# The QCEW employment files need no key, only LAUS does.
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# HUD User API (Fair Market Rents cross-check). Free account, generate a token
# on your HUD User account page.
# https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=
